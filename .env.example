# EngineMarket.eu environment. Copy to .env.local and fill in what you use.
# With none of the MAIL variables set, every form prints its email to the server console and still succeeds.

# --- Site ----------------------------------------------------------------
# Canonical origin for links in the sitemap, robots.txt, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://enginemarket.eu

# --- Mail: who sends, who receives ----------------------------------------
# Sender shown on every email (must be a verified sender at your mail provider).
MAIL_FROM="EngineMarket <sales@enginemarket.eu>"
# Inbox that receives reservations, questions, engine searches and trade applications.
MAIL_TO=sales@enginemarket.eu

# --- Mail option A: Resend (https://resend.com) ---------------------------
# Set this and mail goes through Resend's HTTP API. Takes priority over SMTP.
RESEND_API_KEY=

# --- Mail option B: any SMTP server -----------------------------------------
# Used when RESEND_API_KEY is empty and SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); leave "false" for 587 with STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Reservations store ---------------------------------------------------
# JSON file that holds the 48-hour reservations. Default: .data/reservations.json
# (on Vercel: the OS temp folder, which is NOT shared between instances: use a database there,
# see README "Reservations in production").
RESERVATIONS_FILE=

# --- Tests ------------------------------------------------------------------
# Port for the Playwright test server (default 3100).
E2E_PORT=3100
# Browser channel for Playwright: "chrome" (default, the installed Google Chrome) or "" for Playwright's Chromium.
PW_CHANNEL=chrome
